    <!-- NOTATKA 0: SPIS TRESCI -->
    <note>
        <title>SPIS TRESCI - Struktura e-Segregator HACCP</title>
        <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
        <en-note>
            <div style="text-align:center; padding:30px 20px; background: linear-gradient(135deg, #004F5D 0%, #007380 100%); color:white; margin:-10px -10px 20px -10px;">
                <h1 style="font-size:28px; margin-bottom:10px;">SPIS TRESCI</h1>
                <p style="font-size:16px; color:#00FFF7;">e-Segregator HACCP - Struktura Systemu</p>
                <p style="font-size:12px; color:#a0d4d4; margin-top:20px;">by INOVIT | www.inovit.com.pl</p>
            </div>

            <div style="background-color:#e6f3f5; padding:15px; border-left:5px solid #00FFF7; margin:20px 0;">
                <p><b>Instrukcja:</b> Po zaimportowaniu do Evernote, kliknij prawym przyciskiem na tytul notatki w spisie ponizej i wybierz "Kopiuj lacze wewnetrzne", a nastepnie wklej jako lacze. Dzieki temu utworzysz aktywna nawigacje miedzy notatkami.</p>
            </div>

            <hr style="border-color:#007380;"/>

            <h2 style="color:#004F5D;">Notatki w tym zbiorze:</h2>

            <table border="1" cellpadding="10" cellspacing="0" style="width:100%; border-collapse:collapse; border-color:#007380;">
                <tr style="background-color:#004F5D; color:white;">
                    <th style="width:50px;">Nr</th>
                    <th>Tytul notatki</th>
                    <th style="width:150px;">Kategoria</th>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>00</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">00. e-Segregator HACCP - Wprowadzenie do systemu</span></td>
                    <td>Wprowadzenie</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>01</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">01. STACK 0: Strona tytulowa i dane zakladu</span></td>
                    <td>Stack 0</td>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>02</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">02. STACK I: Warunki wstepne (GHP/GMP)</span></td>
                    <td>Stack I</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>03</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">03. STACK II: System HACCP (12 krokow)</span></td>
                    <td>Stack II</td>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>04</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">04. STACK III: Procedury i instrukcje</span></td>
                    <td>Stack III</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>05</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">05. STACK IV: Formularze i zapisy biezace</span></td>
                    <td>Stack IV</td>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>06</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">06. STACK V: Szkolenia i personel</span></td>
                    <td>Stack V</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>07</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">07. STACK VI: Audyty i przeglady</span></td>
                    <td>Stack VI</td>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>08</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">08. STACK VII: Dostawcy i klienci</span></td>
                    <td>Stack VII</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>09</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">09. STACK VIII: Infrastruktura i urzadzenia</span></td>
                    <td>Stack VIII</td>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>10</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">10. STACK IX: Aktualizacje prawne i baza wiedzy</span></td>
                    <td>Stack IX</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>11</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">11. STACK X: Archiwum</span></td>
                    <td>Stack X</td>
                </tr>
                <tr>
                    <td style="text-align:center;"><b>12</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">12. System tagowania e-Segregator HACCP</span></td>
                    <td>Instrukcja</td>
                </tr>
                <tr style="background-color:#e6f3f5;">
                    <td style="text-align:center;"><b>13</b></td>
                    <td><span style="color:#007380; text-decoration:underline;">13. PULPIT KONTROLNY - Dashboard</span></td>
                    <td>Dashboard</td>
                </tr>
            </table>

            <hr style="border-color:#007380;"/>

            <h2 style="color:#004F5D;">Szybki przeglad struktury:</h2>

            <div style="display:flex; flex-wrap:wrap; gap:10px;">
                <div style="background-color:#004F5D; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack 0</b> - Dane zakladu</div>
                <div style="background-color:#007380; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack I</b> - GHP/GMP</div>
                <div style="background-color:#004F5D; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack II</b> - HACCP</div>
                <div style="background-color:#007380; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack III</b> - Procedury</div>
                <div style="background-color:#004F5D; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack IV</b> - Rejestry</div>
                <div style="background-color:#007380; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack V</b> - Szkolenia</div>
                <div style="background-color:#004F5D; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack VI</b> - Audyty</div>
                <div style="background-color:#007380; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack VII</b> - Dostawcy</div>
                <div style="background-color:#004F5D; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack VIII</b> - Infrastruktura</div>
                <div style="background-color:#007380; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack IX</b> - Przepisy</div>
                <div style="background-color:#004F5D; color:white; padding:10px 15px; border-radius:5px; margin:5px;"><b>Stack X</b> - Archiwum</div>
            </div>

            <p style="font-size:10px; color:#007380; margin-top:30px;"><i>Wersja dokumentu: 2.0 | Data: 2026-01-16 | INOVIT e-Segregator HACCP</i></p>
        </en-note>]]>
