    <!-- NOTATKA 13: SYSTEM TAGOWANIA -->
    <note>
        <title>12. System tagowania e-Segregator HACCP</title>
        <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
        <en-note>
            <div style="background-color:#e6f3f5; padding:8px 15px; margin:-10px -10px 0 -10px; border-bottom:2px solid #007380;">
                <span style="color:#007380; text-decoration:underline; font-size:14px;">&#8592; SPIS TRESCI - Struktura e-Segregator HACCP</span>
            </div>

            <div style="background-color:#004F5D; color:white; padding:15px; margin:0 -10px 20px -10px;">
                <h1 style="margin:0;">SYSTEM TAGOWANIA</h1>
                <p style="margin:5px 0 0 0; font-size:14px; color:#00FFF7;">Szybkie wyszukiwanie i kategoryzacja</p>
            </div>

            <h2 style="color:#004F5D;">Tagi glowne (kategorie):</h2>
            <table border="1" cellpadding="8" cellspacing="0" style="width:100%; border-collapse:collapse; border-color:#007380;">
                <tr style="background-color:#007380; color:white;">
                    <th>Tag</th>
                    <th>Opis</th>
                </tr>
                <tr><td><code>00_Dane_Zakladu</code></td><td>Informacje o zakladzie</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>01_GHP</code></td><td>Dobra Praktyka Higieniczna</td></tr>
                <tr><td><code>02_GMP</code></td><td>Dobra Praktyka Produkcyjna</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>03_HACCP</code></td><td>System HACCP, analiza zagrozen</td></tr>
                <tr><td><code>04_Procedury</code></td><td>Procedury ogolne i instrukcje</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>05_Formularze_i_Zapisy</code></td><td>Rejestry i formularze</td></tr>
                <tr><td><code>06_Szkolenia</code></td><td>Materialy szkoleniowe i personel</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>07_Audyty</code></td><td>Audyty i przeglady</td></tr>
                <tr><td><code>08_Infrastruktura</code></td><td>Urzadzenia i plany zakladu</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>09_Przepisy_Prawne</code></td><td>Akty prawne i interpretacje</td></tr>
                <tr><td><code>99_Archiwum</code></td><td>Dokumenty archiwalne</td></tr>
            </table>

            <hr style="border-color:#007380;"/>

            <h2 style="color:#004F5D;">Tagi funkcjonalne:</h2>
            <table border="1" cellpadding="8" cellspacing="0" style="width:100%; border-collapse:collapse; border-color:#007380;">
                <tr style="background-color:#004F5D; color:white;">
                    <th>Tag</th>
                    <th>Znaczenie</th>
                </tr>
                <tr><td><code>Do_Wypelniania</code></td><td>Rejestry biezace do codziennego uzywania</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>Szablon</code></td><td>Wzory formularzy do kopiowania</td></tr>
                <tr><td style="color:#004F5D;"><b><code>CCP</code></b></td><td>Krytyczne Punkty Kontroli</td></tr>
                <tr style="background-color:#e6f3f5;"><td style="color:#004F5D;"><b><code>Pilne</code></b></td><td>Wymagajace natychmiastowej akcji</td></tr>
                <tr><td style="color:#007380;"><code>Zatwierdzone</code></td><td>Dokumenty zatwierdzone przez kierownictwo</td></tr>
                <tr style="background-color:#e6f3f5;"><td><code>Do_Aktualizacji</code></td><td>Wymagajace przegladu</td></tr>
            </table>

            <hr style="border-color:#007380;"/>

            <h2 style="color:#004F5D;">Tagi specyficzne dla zakladu:</h2>
            <ul>
                <li><code>Zaklad_Miesny</code></li>
                <li><code>Produkcja_Kielbas</code></li>
                <li><code>Rok_2026</code></li>
            </ul>

            <div style="background-color:#e6f3f5; padding:15px; border-left:5px solid #00FFF7; margin:20px 0;">
                <p><b>Wskazowka:</b> Uzywaj tagow konsekwentnie! Dzieki nim znajdziesz dowolny dokument w kilka sekund.</p>
            </div>

            <p style="font-size:10px; color:#007380; margin-top:30px;"><i>INOVIT e-Segregator HACCP | System tagowania</i></p>
        </en-note>]]>
